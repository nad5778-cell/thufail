# Oracle connection (read-only DB user recommended)
ORACLE_USER=readonly_user
ORACLE_PASSWORD=changeme
ORACLE_DSN=hostname:1521/service_name

# Views/synonyms the app is allowed to query — must already be read-only
ORACLE_PIC_SUMMARY_VIEW=V_PIC_SUMMARY
ORACLE_PIC_DETAIL_VIEW=V_PIC_DETAIL

# Read-only view/synonym exposing NATIONAL_IDENTITY, FIRST_NAME and
# INSURANCE_COMPANY_NUMBER (e.g. a view over RPLMEMBER), used for the
# national-identity anomaly check.
ORACLE_MEMBER_VIEW=V_PIC_MEMBER

# CORS
FRONTEND_ORIGIN=http://localhost:5173
